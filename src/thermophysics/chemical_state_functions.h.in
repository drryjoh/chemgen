#define {internal_energy_or_temperature}

{device_option}
{scalar_function} 
temperature({chemical_state_parameter} chemical_state) {const_option} 
{{
    return
#if defined(CHEMGEN_INTERNAL_ENERGY_EQUATION)
    temperature(get_energy(chemical_state), get_species(chemical_state));
#elif defined(CHEMGEN_TEMPERATURE_EQUATION)
    get_energy(chemical_state);
#else
#error
#endif
}}

{device_option}
{chemical_state_function} 
source({chemical_state_parameter} chemical_state) {const_option} 
{{
    return 
    set_chemical_state(source_energy(get_species(chemical_state), temperature(chemical_state)),
                       source(get_species(chemical_state), temperature(chemical_state)));
}}

#undef {internal_energy_or_temperature}
