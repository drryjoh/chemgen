{device_option}
{chemical_state} 
backwards_euler({chemical_state} y,  
                {scalar_parameter} dt,
                // int & csv_iter, 
                {index}  &n_gmres_iter_total,
                {scalar} abs_newton_tol = newton_abs_tol_default,
                {scalar} rel_newton_tol = newton_rel_tol_default,
                {index}  max_iter = newton_iter_max_default)
{{
        {chemical_state} y_init = y;
        {chemical_state} y_guess = y;

        {jacobian_eigen} A;
        {declare_linear_solver_eigen}
        {declare_compute_flag}
        {initialize_compute_flag}

        for ({index} iter = 0; iter < max_iter; ++iter)
        {{
            {update_compute_flag}
            {scalar} temperature_ = temperature(y[0], y_guess);
            {chemical_state} f = source(y_guess, temperature_);
            {chemical_state} res = {{}};

            {if_compute_flag}
            {{
                A = source_jacobian(y_guess, temperature_, -1, 1/dt);
            }}
            //................................................................
            // Eigen::MatrixXd denseA = Eigen::MatrixXd(A);
            // std::ostringstream ss;
            // ss << "BE_DATA/jacobian_" << csv_iter << ".csv"; //change path
            // std::ofstream out(ss.str());
            // for (int i = 0; i < denseA.rows(); ++i) 
            // {{
            //     for (int j = 0; j < denseA.cols(); ++j) 
            //     {{
            //         out << denseA(i, j);
            //         if (j + 1 < denseA.cols())
            //             out << ",";
            //     }}
            //     out << "\n";
            // }}
            // csv_iter += 1;
            //^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

            //RHS
            res = scale_gen(-{scalar_cast}(1)/dt, y_guess - y_init) + f;
            //Solve
            #ifdef CHEMGEN_DIRECT_SOLVER
            {chemical_state} dy = direct_solve(A, res{solver_and_compute_flag_arguments});
            #else
            {chemical_state} dy = gmres_solve(A, res{solver_and_compute_flag_arguments}, n_gmres_iter_total);
            #endif

            //Increment
            y_guess = y_guess + dy;

            if (error_norm(dy, y_guess, abs_newton_tol, rel_newton_tol) < 1.0)
            {{
                // std::cout << "# Newton iterations = " << iter + 1 << std::endl;
                return y_guess;
            }}
        }}

        // std::cout << "Newton solve did not converge!" << std::endl;

        return y_guess; //sets energy to zero to signal integration broke
}}
