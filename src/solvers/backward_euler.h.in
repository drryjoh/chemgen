#ifdef CHEMGEN_PROFILE
LinearSolveResult
#else
{device_option}
{chemical_state_function}
#endif
backwards_euler({chemical_state} y,  
                {scalar_parameter} dt,
                {scalar} abs_newton_tol = newton_abs_tol_default,
                {scalar} rel_newton_tol = newton_rel_tol_default,
                {index}  max_iter = newton_iter_max_default)
{{
        {chemical_state} y_init = y;
        {chemical_state} y_guess = y;
        #ifdef CHEMGEN_PROFILE
        {index} running_linear = 0;
        #endif
        for ({index} iter = 0; iter < max_iter; ++iter)
        {{
            {scalar} temperature_ = temperature(y[0], y_guess);
            {chemical_state} f = source(y_guess, temperature_);
            {jacobian} J = source_jacobian(y_guess, temperature_);
            {jacobian} A = jacobian_I();
            {chemical_state} res = {{}};
            
            //LHS
            for ({index} i = 0; i < n_variables; ++i) A[i][i] = A[i][i]/dt;
            A = A - J;

            //RHS
            res = scale_gen(-{scalar_cast}(1)/dt, y_guess - y_init) + f;
            //Solve
            #ifdef CHEMGEN_DIRECT_SOLVER
            {chemical_state} dy = invert_jacobian(A) * res;
            #else
            #ifdef CHEMGEN_PROFILE
            LinearSolveResult solve_1 = gmres_solve(A, res);
            {chemical_state} dy = solve_1.result;
            running_linear += solve_1.linear_iterations;
            #else
            {chemical_state} dy = gmres_solve(A, res);
            #endif
            #endif //CHEMGEN_DIRECT_SOLVER

            //Increment
            y_guess = y_guess + dy;

            if (error_norm(dy, y_guess, abs_newton_tol, rel_newton_tol) < 1.0)
            {{
                return
                #ifdef CHEMGEN_PROFILE
                {{y_guess, running_linear, iter+1}}; //yn = yn + m1 * k1 + m2 * k2
                #else
                y_guess; //yn = yn + m1 * k1 + m2 * k2
                #endif
            }}
        }}

        std::cout << "Newton solve did not converge!" << std::endl;

        return
        #ifdef CHEMGEN_PROFILE
        {{y_guess, running_linear, max_iter}}; //yn = yn + m1 * k1 + m2 * k2
        #else
        y_guess; //yn = yn + m1 * k1 + m2 * k2
        #endif
}}
