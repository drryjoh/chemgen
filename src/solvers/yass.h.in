
{device_option}
{chemical_state} 
yass({chemical_state} y,  
     {scalar_parameter} dt, 
     {scalar} max_norm  = 0.1,
     {scalar} min_dt  = 1e-10,
     {index} max_iter = 20)
{{

    {chemical_state} y_init = y;
    {chemical_state} y_n = y_init;
    {scalar} dt_ = dt;
    {scalar} time = 0;
    {index} iteration = 0;

    while(time < dt && iteration < max_iter)
    {{

        {scalar} temperature_ = temperature(y[0], y_n);
        {jacobian_eigen} G = source_jacobian(y_n, temperature_, -dt_, 1);
        {chemical_state} rhs1 = scale_gen(dt_, source(y_n, temperature_));

        #ifdef CHEMGEN_DIRECT_SOLVER
        {chemical_state} dy = invert_jacobian(G) * rhs1;
        #else
        {chemical_state} dy = gmres_solve(G, rhs1);
        #endif

        {scalar} dy_norm  = norm2(get_species(dy));

        if (dy_norm > max_norm)
        {{
            std::cout << "refining YASS; dy: " <<dy_norm<<std::endl;
            dt_ *= {scalar_cast}(0.5);
            if (dt_ < min_dt)
            {{
                    return scale_gen({scalar_cast}(0.0), y_n); //return garbage
            }}
        }}
        else
        {{
            time+=dt_;
            y_n = y_n + dy; 
        }}

        iteration++;
    }}

    return y_n;
}}
