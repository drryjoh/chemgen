{preconditioner}
{direct_solver}
{eigen}

#ifdef CHEMGEN_PRECONDITIONER_JACOBI
{device_option}
{chemical_state_function} inverse_diagonal({jacobian_function} J) {const_option}
{{
    {chemical_state} diag_inv;
    for ({index} i = 0; i < n_variables; ++i)
    {{
        diag_inv[i] = std::abs(J[i][i]) > 1e-14 ? 1.0 / J[i][i] : 0.0;
    }}
    return diag_inv;
}}
#endif

#ifdef CHEMGEN_PRECONDITIONER_GAUSS_SEIDEL
{device_option}
{chemical_state_function}
apply_gauss_seidel({jacobian_function} A, {chemical_state_function} v)
{{
    {chemical_state} z = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        {scalar} sum = 0.0;
        for ({index} j = 0; j < i; ++j)
            sum += A[i][j] * z[j]; // Already computed values of z

        // Diagonal + lower
        {scalar} diag = A[i][i];
        z[i] = (v[i] - sum) / (std::abs(diag) > 100.*std::numeric_limits<{scalar}>::epsilon() ? diag : 1.0); // Avoid div by zero
    }}
    return z;
}}
#endif

#ifdef CHEMGEN_EIGEN
{device_option}
{chemical_state_function}
gmres_solve({jacobian_parameter_eigen} A, {chemical_state_parameter} b_, {index} &n_gmres_iter_total, {scalar} abs_tol=linear_abs_tol_default, {scalar} rel_tol=linear_rel_tol_default)
{{
    using namespace Eigen;

    {chemical_state_eigen} b(n_variables);

    for ({index} i = 0; i < n_variables; ++i)
    {{
        b(i) = b_[i];
    }}

    #ifdef CHEMGEN_PRECONDITIONER_JACOBI
    GMRES<{jacobian_eigen_dynamic}, DiagonalPreconditioner<{scalar}>> gmres;
    #elif defined(CHEMGEN_PRECONDITIONER_ILU)
    GMRES<{jacobian_eigen_dynamic}, IncompleteLUT<{scalar}>> gmres;

    // gmres.preconditioner().setFillfactor(10); // default value
    gmres.preconditioner().setFillfactor(n_variables * n_variables); // allow for maximum fill-in, such that only droptol controls ilu sparsity

    gmres.preconditioner().setDroptol(NumTraits<{scalar}>::dummy_precision()); // default value
    //gmres.preconditioner().setDroptol(0.001);
    #else
    GMRES<{jacobian_eigen_dynamic}, IdentityPreconditioner> gmres;
    #endif

    gmres.setMaxIterations(n_variables); // total number of iterations including restarts
    gmres.set_restart(n_variables); // # iterations before restart (Full-size Krylov subspace)

    gmres.compute(A); // preconditioner initialized here
    if (gmres.preconditioner().info() != Success) std::cerr << "Preconditioner failed!" << std::endl;

    // eigen uses relative tolerance - https://eigen.tuxfamily.org/dox/unsupported/GMRES_8h_source.html
    {scalar} tol = std::max(rel_tol, divide(abs_tol, gmres.preconditioner().solve(b).norm()));
    gmres.setTolerance(tol);

    {chemical_state_eigen} x = gmres.solve(b);

    // std::cout << "gmres.iterations() = " << gmres.iterations() << std::endl;
    if (gmres.info() != Success) std::cerr << "GMRES failed!" << std::endl;

    n_gmres_iter_total += gmres.iterations();

    // Convert back to chemical_state
    {chemical_state} result = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        result[i] = x(i);
    }}

    return result;
}}

#else

{device_option}
{chemical_state_function}
gmres_solve({jacobian_parameter} A, {chemical_state_parameter} b, {index} &n_gmres_iter_total, {scalar} abs_tol=linear_abs_tol_default, {scalar} rel_tol=linear_rel_tol_default)
{{
	{index} max_iter = 100;
    {chemical_state} x = {{}};
	{chemical_state} cs = {{}};
	{chemical_state} sn = {{}};

    // Note: if initial guess for x is nonzero, need to replace b below with (b - A*x)
#ifdef CHEMGEN_PRECONDITIONER_JACOBI
	{chemical_state} diag_inv = inverse_diagonal(A);
    {chemical_state} r = diag_inv * (b);
#elif defined(CHEMGEN_PRECONDITIONER_GAUSS_SEIDEL)
    {chemical_state} r = apply_gauss_seidel(A, b);
#else
	{chemical_state} r = b;
#endif

	{scalar} norm2_r = norm2(r);

    if (norm2_r < std::numeric_limits<{scalar}>::epsilon())
    {{
        // std::cout << "# GMRES iterations = 0" << std::endl;
        return x;
    }}

    std::array<{chemical_state}, n_variables + 1> V = {{}};
    V[0] = scale_gen(inv_gen(norm2_r), r);

    std::array<std::array<{scalar}, n_variables>, n_variables + 1> H = {{}};
    std::array<{scalar}, n_variables + 1> g = {{}};
    g[0] = norm2(r);

	{index} final_iter = 0;

    for ({index} j = 0; j < n_variables; ++j)
    {{
		final_iter = j;

        {chemical_state} w = A * V[j];
#ifdef CHEMGEN_PRECONDITIONER_JACOBI
        w = diag_inv * w;
#elif defined(CHEMGEN_PRECONDITIONER_GAUSS_SEIDEL)
        w = apply_gauss_seidel(A, w);
#endif

        // Modified Gram-Schmidt
        for ({index} i = 0; i <= j; ++i)
        {{
            H[i][j] = dot(V[i], w);
            w = w - H[i][j] * V[i];
        }}

        H[j+1][j] = norm2(w);

        V[j+1] = scale_gen(inv_gen(H[j+1][j]),w); // not used if j == n_variables - 1

		// Apply Givens rotations to new column of H
		for (int i = 0; i < j; ++i)
		{{
			{scalar} temp = cs[i] * H[i][j] + sn[i] * H[i+1][j];
			H[i+1][j] = -sn[i] * H[i][j] + cs[i] * H[i+1][j];
			H[i][j] = temp;
		}}
        // Compute new Givens rotation
        {scalar} a = H[j][j];
        {scalar} b_h = H[j+1][j];
        {scalar} r_val = std::sqrt(a * a + b_h * b_h);
        cs[j] = a / r_val;
        sn[j] = b_h / r_val;

        // Apply to H and g
        H[j][j] = r_val;
        H[j+1][j] = 0.0;
		
        {scalar} temp_g = cs[j] * g[j];
        g[j+1] = -sn[j] * g[j];
        g[j] = temp_g;
		
        // Convergence check
        {scalar} res_norm = std::abs(g[j+1]);
        if (res_norm < abs_tol || res_norm < rel_tol * norm2_r)
            break;
    }}

    // Solve least squares problem Hy = g using back-substitution on H (upper triangular, rectangular)
    std::array<{scalar}, n_variables> y = {{}};
    for ({index} i = final_iter; i >= 0; --i)
    {{
        {scalar} sum = 0;
		for ({index} j = i + 1; j <= final_iter; ++j)
            sum += H[i][j] * y[j];
        y[i] = (g[i] - sum) / H[i][i];
    }}

    {chemical_state} result = {{}};
    for ({index} i = 0; i < final_iter + 1; ++i)
        result = result + y[i] * V[i];

    if (final_iter + 1 < n_variables)
    {{
        // std::cout << "# GMRES iterations = " << final_iter + 1 << std::endl;
    }}

    n_gmres_iter_total += final_iter + 1;

    return result;
}}
#endif
