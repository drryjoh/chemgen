{preconditioner}
{direct_solver}
{eigen}

#ifdef CHEMGEN_PRECONDITIONER_JACOBI
{device_option}
{jacobian_function} inverse_diagonal({jacobian_function} J) {const_option}
{{
    {jacobian} M_inv = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        M_inv[i][i] = std::abs(J[i][i]) > 1e-14 ? 1.0 / J[i][i] : 0.0;
    }}
    return M_inv;
}}

{device_option}
{jacobian_function} apply_diagonal({jacobian_function} P, {jacobian_function} A) {const_option}
{{
    {jacobian} M = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        for ({index} j = 0; j < n_variables; ++j)
        {{
            M[i][j] = P[i][i] * A[i][j];
        }}
    }}
    return M;
}}

{device_option}
{chemical_state_function} apply_diagonal({jacobian_function} P, {chemical_state} b) {const_option}
{{
    {chemical_state} m = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        m[i] = P[i][i] * b[i];
    }}
    return m;
}}
#endif

#ifdef CHEMGEN_PRECONDITIONER_GAUSS_SEIDEL
{device_option}
{chemical_state_function}
apply_gauss_seidel({jacobian_function} A, {chemical_state_function} v)
{{
	{chemical_state} z = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        {scalar} sum = 0.0;
        for ({index} j = 0; j < i; ++j)
            sum += A[i][j] * z[j]; // Already computed values of z

        // Diagonal + lower
        {scalar} diag = A[i][i];
        z[i] = (v[i] - sum) / (std::abs(diag) > 1e-14 ? diag : 1.0); // Avoid div by zero
    }}
    return z;
}}
#endif

#ifdef CHEMGEN_EIGEN
{device_option}
{chemical_state_function}
gmres_eigen({jacobian_parameter} A_, {chemical_state_parameter} b_, {scalar} abs_tol, {scalar} rel_tol)
{{
    using namespace Eigen;

    MatrixXd A(n_variables, n_variables);  // or A.resize(n_variables, n_variables);
    VectorXd b(n_variables);

    for ({index} i = 0; i < n_variables; ++i)
    {{
        b(i) = b_[i];
        for ({index} j = 0; j < n_variables; ++j)
        {{
            A(i, j) = A_[i][j];
        }}
    }}

    #ifdef CHEMGEN_PRECONDITIONER_JACOBI
    GMRES<MatrixXd, DiagonalPreconditioner<{scalar}>> gmres;
    #else
    GMRES<MatrixXd, IdentityPreconditioner> gmres;
    #endif

    gmres.setMaxIterations(n_variables); // total number of iterations including restarts
    gmres.set_restart(n_variables); // # iterations before restart (Full-size Krylov subspace)

    gmres.compute(A);

    // eigen uses relative tolerance - https://eigen.tuxfamily.org/dox/unsupported/GMRES_8h_source.html
    {scalar} tol = std::max(rel_tol, divide(abs_tol, gmres.preconditioner().solve(b).norm()));
    gmres.setTolerance(tol);

    VectorXd x = gmres.solve(b);

    // Convert back to chemical_state
    {chemical_state} result = {{}};
    for ({index} i = 0; i < n_variables; ++i)
        result[i] = x(i);

    return result;
}}
#endif

{device_option}
{chemical_state_function}
gmres_solve({jacobian_parameter} A, {chemical_state_parameter} b, {scalar} abs_tol = 1e-8, {scalar} rel_tol = 1e-4)
{{
#ifdef CHEMGEN_EIGEN
    return gmres_eigen(A, b, abs_tol, rel_tol);
#else
	{index} max_iter = 100;
    {chemical_state} x = {{}};
	{chemical_state} cs = {{}};
	{chemical_state} sn = {{}};
#ifdef CHEMGEN_PRECONDITIONER_JACOBI
	{jacobian} P = inverse_diagonal(A);
	{jacobian} A_ = apply_diagonal(P, A);
	{chemical_state} b_ = apply_diagonal(P, b);
#else
	{jacobian} A_ = A;
	{chemical_state} b_ = b;
#endif

    {chemical_state} r = b_ - (A_ * x); // preconditioned residual
	{scalar} norm2_r = norm2(r);

    if (norm2_r < std::numeric_limits<{scalar}>::epsilon())
    {{
        // std::cout << "# GMRES iterations = 0" << std::endl;
        return x;
    }}

    std::array<{chemical_state}, n_variables + 1> V = {{}};
    V[0] = scale_gen(inv_gen(norm2_r), r);

    std::array<std::array<{scalar}, n_variables>, n_variables + 1> H = {{}};
    std::array<{scalar}, n_variables + 1> g = {{}};
    g[0] = norm2(r);

	{index} final_iter = 0;

    for ({index} j = 0; j < n_variables; ++j)
    {{
		final_iter = j;
        {chemical_state} w = A_ * V[j];

        // Modified Gram-Schmidt
        for ({index} i = 0; i <= j; ++i)
        {{
            H[i][j] = dot(V[i], w);
            w = w - H[i][j] * V[i];
        }}

        H[j+1][j] = norm2(w);

        V[j+1] = scale_gen(inv_gen(H[j+1][j]),w); // not used if j == n_variables - 1

		// Apply Givens rotations to new column of H
		for (int i = 0; i < j; ++i)
		{{
			{scalar} temp = cs[i] * H[i][j] + sn[i] * H[i+1][j];
			H[i+1][j] = -sn[i] * H[i][j] + cs[i] * H[i+1][j];
			H[i][j] = temp;
		}}
        // Compute new Givens rotation
        {scalar} a = H[j][j];
        {scalar} b_h = H[j+1][j];
        {scalar} r_val = std::sqrt(a * a + b_h * b_h);
        cs[j] = a / r_val;
        sn[j] = b_h / r_val;

        // Apply to H and g
        H[j][j] = r_val;
        H[j+1][j] = 0.0;
		
        {scalar} temp_g = cs[j] * g[j];
        g[j+1] = -sn[j] * g[j];
        g[j] = temp_g;
		
        // Convergence check
        {scalar} res_norm = std::abs(g[j+1]);
        if (res_norm < abs_tol || res_norm < rel_tol * norm2_r)
            break;
    }}

    // Solve least squares problem Hy = g using back-substitution on H (upper triangular, rectangular)
    std::array<{scalar}, n_variables> y = {{}};
    for ({index} i = final_iter; i >= 0; --i)
    {{
        {scalar} sum = 0;
		for ({index} j = i + 1; j <= final_iter; ++j)
            sum += H[i][j] * y[j];
        y[i] = (g[i] - sum) / H[i][i];
    }}

    {chemical_state} result = {{}};
    for ({index} i = 0; i < final_iter + 1; ++i)
        result = result + y[i] * V[i];

    if (final_iter + 1 < n_variables)
    {{
        // std::cout << "# GMRES iterations = " << final_iter + 1 << std::endl;
    }}

    return result;
#endif
}}

