#ifdef CHEMGEN_PROFILE
LinearSolveResult
#else
{device_option}
{chemical_state_function}
#endif
rosenbroc({chemical_state} y,
          {scalar_parameter} dt)
{{
        //constants
        {chemical_state} y_init = y;
        {scalar} gamma = 1.0 + 1.0 / sqrt_gen({scalar}(2));
        {scalar} alpha = 1.0/gamma;
        {scalar} beta = -2.0/gamma;
        {scalar} m1 = 3.0/(2.0 * gamma);
        {scalar} m2 = 1.0/(2.0 * gamma);
        {scalar} one_minus_gamma = 1.0 - gamma;

        {scalar} temperature_ = temperature(y[0], y_init);
        const {jacobian} I = jacobian_I();
        {jacobian} J = source_jacobian(y_init, temperature_);
        {jacobian} G = scale_gen((1.0/(gamma* dt)),  I) - J;// shared for all stages

        // Stage 1
        {chemical_state} rhs1 = source(y_init, temperature_);
        #ifdef CHEMGEN_DIRECT_SOLVER
        {chemical_state} k1 = invert_jacobian(G) * rhs1;
        #else
        #ifdef CHEMGEN_PROFILE
        LinearSolveResult solve_1 = gmres_solve(G, rhs1);
        {chemical_state} k1 = solve_1.result;
        {index} n_iter_1 = solve_1.linear_iterations;
        #else
        {chemical_state} k1 = gmres_solve(G, rhs1);
        #endif
        #endif
        
        // Stage 2
        {chemical_state} y_stage = y_init + alpha * k1;
        {scalar} temperature_stage = temperature(y[0], y_stage);

        {chemical_state} rhs2 = source(y_stage, temperature_stage) + beta/dt * k1 - rhs1; //source(y_stage) - J @ (a21 * dt * k1)

        #ifdef CHEMGEN_DIRECT_SOLVER
        {chemical_state} dk = invert_jacobian(G) * rhs2;
        #else
        #ifdef CHEMGEN_PROFILE
        LinearSolveResult solve_2 = gmres_solve(G, rhs1);
        {chemical_state} dk = solve_2.result;
        {index} n_iter_2 = solve_2.linear_iterations;
        #else
        {chemical_state} dk = gmres_solve(G, rhs1);
        #endif
        #endif

        {chemical_state} k2 = k1 + dk;
        return 
        #ifdef CHEMGEN_PROFILE
        {{y_init + scale_gen(m1, k1) + scale_gen(m2, k2), 
          n_iter_1 + n_iter_2, 
          2}}; //yn = yn + m1 * k1 + m2 * k2
        #else
        y_init + scale_gen(m1, k1) + scale_gen(m2, k2); //yn = yn + m1 * k1 + m2 * k2
        #endif
}}
