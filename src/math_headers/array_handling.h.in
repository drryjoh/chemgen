{device_option}
{species_function}
get_species({chemical_state_parameter} y) {const_option}
{{
    {species} s;
    for ({index} i = 1; i <= n_species; i++)
    {{
        s[i-1] = y[i];
    }}
    return s;
}}

{device_option}
{scalar_function}
get_energy({chemical_state_parameter} y) {const_option}
{{
    return y[0];
}}

{device_option}
{chemical_state_function}
set_chemical_state({scalar_parameter} energy, // internal_energy or temperature
                   {species_parameter} species) {const_option}
{{
    // TODO: modify in place?
    {chemical_state} y;
    for ({index} i = 1; i <= n_species; i++)
    {{
        y[i] = species[i-1];
    }}
    y[0] = energy;
    return y;
}}

{device_option}
{scalar_function} norm2({species_parameter} x) {const_option}
{{
    {scalar} sum = {scalar_cast}(0.0);
    for ({index} i  = 0; i<n_species; i++)
    {{
        sum += x[i] * x[i];
    }}
    return sqrt_gen(sum);
}}

{device_option}
{scalar_function} sum_sqr_ref({species_parameter} x, {species_parameter} x_ref) {const_option}
{{
    {scalar} x_ref_min = {scalar_cast}(1);
    {scalar} x_ref_max = {scalar_cast}(0);
    for ({index} i  = 0; i<n_species; i++)
    {{
        if (x_ref[i] > x_ref_max)
        {{
            x_ref_max = x_ref[i];
        }}
        if (x_ref[i] < x_ref_min && x_ref[i] > {scalar_cast}(1e-6))
        {{
            x_ref_min = x_ref[i];
        }}
    }}

    {scalar} factor  = inv_gen(x_ref_max - x_ref_min);
    factor  = factor * factor;

    {scalar} sum = {scalar_cast}(0.0);
    for ({index} i  = 0; i<n_species; i++)
    {{
        sum += x[i] * x[i] * factor;
    }}
    return sum;
}}

{device_option}
{scalar_function} norm2({chemical_state_parameter} x) {const_option}
{{
    {scalar} sum = {scalar_cast}(0.0);
    for ({index} i  = 0; i<n_variables; i++)
    {{
        sum += x[i] * x[i];
    }}
    return sqrt_gen(sum);
}}

{device_option}
{scalar_function} sum_sqr_ref({chemical_state_parameter} x, {chemical_state_parameter} x_ref) {const_option}
{{
    {scalar} sum = sum_sqr_ref(get_species(x), get_species(x_ref));
    sum += pow2(x[n_variables] * inv_gen(x_ref[n_variables]));
    return sum;
}}

{device_option}
{scalar_function} norm2({chemical_state_parameter} x, {chemical_state_parameter} x_ref) {const_option}
{{
    return sqrt_gen(sum_sqr_ref(x, x_ref));
}}

{device_option}
{scalar_function} norm2({jacobian_parameter} x) {const_option}
{{
    {scalar} sum = {scalar_cast}(0.0);
    for ({index} i  = 0; i < n_variables; i++)
    {{
        for ({index} j  = 0; j < n_variables; j++)
        {{
            sum += x[i][j] * x[i][j];
        }}
    }}
    return sqrt_gen(sum);
}}

{device_option}
{scalar_function} error_norm({chemical_state_parameter} x,
                             {chemical_state_parameter} x_ref,
                             {scalar} abs_tolerance,
                             {scalar} rel_tolerance) {const_option}
{{
    return norm2(inv_gen(fill_gen_chemical_state(abs_tolerance) + scale_gen(rel_tolerance, abs(x_ref))) * x);
}}


{device_option}
{chemical_state_function} operator*({jacobian_parameter} A, {chemical_state_parameter} x) {const_option}
{{
    {chemical_state} r = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        for ({index} j = 0; j < n_variables; ++j)
        {{
            r[i] += A[i][j] * x[j];
        }}
    }}
    return r;
}}

{device_option}
{jacobian_function} operator*({jacobian_parameter} A, {jacobian_parameter} B) {const_option}
{{
    {jacobian} C = {{}};
    for ({index} i = 0; i < n_variables; ++i)
    {{
        for ({index} j = 0; j < n_variables; ++j)
        {{
            C[i][j] = 0.0;
            for ({index} k = 0; k < n_variables; ++k)
            {{
                C[i][j] += A[i][k] * B[k][j];
            }}
        }}
    }}
    return C;
}}

{device_option}
{species_function} operator*({scalar_parameter} s, {species_parameter} a) {const_option}
{{
    return scale_gen(s, a);
}}

{device_option}
{chemical_state_function} operator*({scalar_parameter} s, {chemical_state_parameter} a) {const_option}
{{
    return scale_gen(s, a);
}}

{device_option}
{jacobian_function} operator*({scalar_parameter} s, {jacobian_parameter} a) {const_option}
{{
    return scale_gen(s, a);
}}

{device_option}
{scalar_function} dot({species_parameter} a, {species_parameter} b) {const_option}
{{
    {scalar} dot_sum = {scalar_cast}(0.0);
    for ({index} i = 0; i < n_species; ++i) dot_sum += a[i]*b[i];
    return dot_sum;
}}

{device_option}
{scalar_function} dot({chemical_state_parameter} a, {chemical_state_parameter} b) {const_option}
{{
    {scalar} dot_sum = {scalar_cast}(0.0);
    for ({index} i = 0; i < n_variables; ++i) dot_sum += a[i]*b[i];
    return dot_sum;
}}

{device_option}
{jacobian_function}
jacobian_I() {const_option}
{{
    {jacobian} I = {{}};
    for ({index} i = 0; i < {jacobian_end}; ++i) I[i][i] = 1.0;
    return I;
}}

#if defined(CHEMGEN_EIGEN)
void
add_species_to_jacobian_row_eigen_sparse(std::vector<Triplet_>& triplet, {index} row_index, {species_parameter} b_s)
{{
    for ({index} j = 0; j < n_species; ++j) triplet.push_back(Triplet_(row_index, j+1, b_s[j]));
}}

void
add_species_to_jacobian_row_eigen({jacobian_eigen_dense}& jacobian, {index} row_index, {species_parameter} b_s)
{{
    for ({index} j = 0; j < n_species; ++j) jacobian(row_index, j+1) += b_s[j];
}}

#else
{device_option}
{chemical_state_function}
add_species_to_chemical_state({chemical_state_parameter} a_s, {species_parameter} b_s) {const_option}
{{
    {chemical_state} c_s;
    c_s[0] = a_s[0];
    {device_element_sum_offset_inl}
    return c_s;
}}
#endif

{device_option}
{species_function}
multiply({species} a, {species} b) {const_option}
{{
    return a * b;
}}

{device_option}
{species_function}
multiply_chain({species} a, {species} a_perturbation, {species} b, {species} b_perturbation) {const_option}
{{
    return a_perturbation * b + a * b_perturbation;
}}

{device_option}
