{species_function}
operator-({species_parameter} a_s, {species_parameter} b_s_positive) {const_option}
{{
    {species} c_s;
    {species} b_s = scale_gen({scalar_cast}(-1.0), b_s_positive);
    {device_element_sum_inl}
    return c_s;
}}

