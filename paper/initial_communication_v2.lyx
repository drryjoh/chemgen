\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
Cpp
\end_layout

\end_inset

 code in the current directory in a 
\begin_inset ERT
status open

\begin_layout Plain Layout


\backslash
texttt{src}
\end_layout

\end_inset

 folder using the standard settings.
\end_layout

