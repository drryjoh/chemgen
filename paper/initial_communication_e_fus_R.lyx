\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{equation}
\frac{y^{n+1}-y^{n}}{\Delta t}=S\left(y^{n+1}\right),\label{eq:Backward_euler}
\end{equation}

\end_inset

where 
\begin_inset Formula $y^{n}$
\end_inset

 is the state at time step 
\begin_inset Formula $n$
\end_inset

.
 Newton's method can be used to find 
\begin_inset Formula $y^{n+1}$
\end_inset

