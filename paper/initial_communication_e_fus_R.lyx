K_{j}^{e}=\frac{k_{j}^{f}}{k_{j}^{r}}\rightarrow k_{j}^{r}=\frac{k_{j}^{f}}{K_{j}^{e}}\label{eq:reverse_rate}
\end{equation}

\end_inset

where
\begin_inset Formula 
\begin{equation}
K_{j}^{e}=\exp\left(-\frac{\Delta G_{j}'}{RT}\right)\left(\frac{p_{\mathrm{ref}}}{R^{}T}\right)^{\sum_{i}\nu_{ij}},\label{eq:equilibrium-constant-1}
